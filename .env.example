# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. These values are for the local Docker database only;
# any deployed environment must set its own.

# Postgres container (docker-compose.yml falls back to these same values)
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot

# Used when you run the API on your machine instead of in Docker
# (the Docker database is published on host port 5433, see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
LOG_LEVEL=INFO
# Largest upload accepted, in MB
MAX_UPLOAD_MB=5
# Optional: pin "today" to the sample data's date for demos (leave unset for the real date)
# APP_TODAY=2026-09-24

# Language model through LiteLLM (decision 024). Defaults: a local Ollama with qwen2.5:7b.
# LLM_MODEL=ollama_chat/qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=            # only for a hosted model, e.g. Gemini for the public demo

# Policy search turns text into vectors with an embedding model (decision 043). It must produce
# 768 numbers per text (the database column's width); nomic-embed-text does. Pull it once:
#   ollama pull nomic-embed-text
# EMBEDDING_MODEL=ollama/nomic-embed-text

# Tracing of model calls in Langfuse (decision 041). Optional: leave the keys out and nothing is
# sent. Create a free project at https://cloud.langfuse.com, then Settings -> API keys.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # https://us.cloud.langfuse.com for a US-region project
