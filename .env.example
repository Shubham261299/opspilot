# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. These values are for the local Docker database only;
# any deployed environment must set its own.

# Postgres container (docker-compose.yml falls back to these same values)
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_DB=opspilot

# Used when you run the API on your machine instead of in Docker
# (the Docker database is published on host port 5433, see docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5433/opspilot
LOG_LEVEL=INFO
# Largest upload accepted, in MB
MAX_UPLOAD_MB=5
# Optional: pin "today" to the sample data's date for demos (leave unset for the real date)
# APP_TODAY=2026-09-24
